{
  "manifest_version": 3,
  "name": "QDM 资源下载助手",
  "version": "0.2.0",
  "minimum_chrome_version": "114",
  "description": "识别当前网页的可下载资源，通过本机连接交给 QDM 下载。支持 Chrome / Edge。",
  "key": "",
  "permissions": [
    "webRequest",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "QDM 资源下载",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}